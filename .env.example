# Create a remotely managed Cloudflare Tunnel and put its token here.
TUNNEL_TOKEN=replace-with-your-tunnel-token

# auto prefers QUIC when UDP/7844 is available and falls back to HTTP/2.
# Set this to quic only after verifying that UDP/7844 is allowed outbound.
TUNNEL_PROTOCOL=auto

# Discord Codex research bot credentials.
DISCORD_TOKEN=replace-with-your-discord-bot-token
ALLOWED_GUILD_ID=replace-with-your-discord-server-id

# Optional response sent when Codex reaches its usage limit.
EXCEED_MESSAGE=
